---
Language: Cpp
BasedOnStyle: Google
Standard: Latest

IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
EmptyLineBeforeAccessModifier: Leave

BreakBeforeBraces: Attach

ColumnLimit: 100

AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: Inline

PointerAlignment: Left
DerivePointerAlignment: false

# Include
SortIncludes: CaseSensitive
IncludeBlocks: Regroup

SpaceAfterTemplateKeyword: true      # template <typename T>
BreakTemplateDeclarations: Yes       # template<...> на отдельной строке
AlignConsecutiveAssignments: Consecutive   # выравнивать = в соседних строках
AlignConsecutiveDeclarations: Consecutive  # выравнивать имена переменных
AllowShortEnumsOnASingleLine: false
BinPackParameters: false             # длинные параметры: каждый на своей строке
InsertBraces: true                   # сам добавит {} к if/for без скобок
SeparateDefinitionBlocks: Always     # пустая строка между функциями
QualifierAlignment: Left             # const int, а не int const
...